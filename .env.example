# Waitlist delivery — src/actions/waitlist.ts
#
# Copy to .env.local for development, and set the same three in the Vercel
# project (Settings → Environment Variables) before pointing a domain at this.
#
# WITHOUT THESE THE FORM STILL RENDERS AND STILL VALIDATES, but it cannot send.
# It says so to the visitor and offers the support address rather than showing a
# confirmation for a submission that went nowhere. That is deliberate: a waitlist
# that silently drops signups is worse than one that is honestly switched off.

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where submissions land. A human reads this and picks the ~10 beta channels.
WAITLIST_TO=support@sudo-cut.com

# The From address. Must be on a domain verified in Resend
# (https://resend.com/domains) — until sudo-cut.com is verified there, Resend's
# shared sender works for testing but will not deliver reliably in production:
#   WAITLIST_FROM=SudoCut <onboarding@resend.dev>
WAITLIST_FROM=SudoCut <waitlist@sudo-cut.com>
